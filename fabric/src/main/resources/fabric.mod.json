{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "issues": "https://github.com/SuperFeda/sfs-anvil-repair/issues",
        "sources": "https://github.com/SuperFeda/sfs-anvil-repair"
    },
    "license": "${license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "net.superfeda.sfs_anvil_repair.SFsAnvilRepair"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": ">=1.21.5 <=1.21.11",
        "forgeconfigapiport": "*",
        "java": ">=${java_version}"
    },
    "suggests": {
        "another-mod": "*"
    }
}
  